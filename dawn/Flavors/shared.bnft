ANY_CHAR:
 "\0x0000".."\0xFFFF"

ALPHA:
 "a".."z"
 "A".."Z"
 
DIGIT:
 "0".."9"

OPTWHITESPACE:
 { " " | "\t" }

WHITESPACE:
 " " | "\t"  OPTWHITESPACE -> " "

OPTNEWLINE:
 { " " | "\t" | "\r" | "\n" }

NEWLINE:
 "\r" | "\n" OPTNEWLINE -> "\n"

ENDLINE:
 OPTWHITESPACE NEWLINE

OPTENDLINE:
 OPTWHITESPACE OPTNEWLINE

SEPARATOR:
 ENDLINE
 WHITESPACE 

OPTSEPARATOR:
 { " " | "\t" | "\r" | "\n" }

SAFE:
 "$" | "-" | "_" | "@" | "." | "&" | ":" | "#" | "=" | "?"

EXTRA:
 "\"" -> "\\\""
 "!" | "*" | "\"" | "'" | "|" | "," | "(" | ")" | "/"

ESCAPE:
 "%" HEX HEX

ESCAPEDECODE:
 ESCAPE { ESCAPE } ->  #decodeuri ESCAPE
 
HEX:
 DIGIT
 "a".."f"
 "A".."F"

ALPHANUMERIC:
 ALPHA | DIGIT
 
XALPHA:
 ALPHANUMERIC | SAFE | EXTRA | ESCAPE

XALPHADECODE:
 ALPHANUMERIC | SAFE | EXTRA | ESCAPEDECODE 

URI:
 ALPHA { XALPHA }

URIDECODE:
 ALPHA { XALPHADECODE }

IDENTIFIER:
 ALPHA { ALPHANUMERIC }

EOT:
 "\0x0004"

ANY_DAWN_CHAR:
 XALPHA | WHITESPACE | NEWLINE | ">"