[Native.Javascript:const%20Resource%20%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FResource%22)%3B%0A%0A%2F%2F%20Content-Type%2Fapplication%2Fjson%20%E2%80%94%20parsed%20JSON%20data%20from%20bytes.%0Afunction%20json()%0A%7B%0A%09Resource.call(this%2C%22json%22)%3B%0A%09this.Processor%20%3D%20jsonProcessor%3B%0A%09return%20this%3B%0A%7D%0A%0Afunction%20jsonProcessor(resource)%0A%7B%0A%09Resource.Processor.call(this%2Cresource)%3B%0A%09this.resource%20%3D%20resource%3B%0A%09this.out_Data%20%3D%20null%3B%0A%09this.in_Blob_%24all%20%3D%20function(input)%0A%20%20%20%20%7B%0A%09%09let%20u8%20%3D%20input.value%20instanceof%20Uint8Array%20%3F%20input.value%20%3A%20new%20Uint8Array(input.value)%3B%0A%09%09let%20text%20%3D%20new%20TextDecoder().decode(u8)%3B%0A%09%09try%20%7B%20resource.value%20%3D%20JSON.parse(text)%3B%20%7D%0A%09%09catch%20(e)%20%7B%20resource.value%20%3D%20text%3B%20%7D%0A%20%20%20%20%7D%0A%09this.in_go%20%3D%20function()%0A%20%20%20%20%7B%0A%09%09return%20this.out_Data%3F.(resource)%3B%0A%20%20%20%20%7D%0A%09this.in_instanciate%20%3D%20function(input)%0A%20%20%20%20%7B%0A%09%09let%20newObject%20%3D%20this.get_resource().clone()%3B%0A%09%09return%20newObject.instanciate_processor()%3B%0A%20%20%20%20%7D%0A%09return%20this%3B%0A%7D%0Ajson.Processor%3DjsonProcessor%3B%0Amodule.exports%3Djson%3B]>>NewResource:application.json
