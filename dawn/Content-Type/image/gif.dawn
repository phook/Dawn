[Native.Javascript:const%20Resource%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FResource%22)%3B%0A%0A%2F%2F%20Content-Type%2Fimage%2Fgif%20%E2%80%94%20The%20image%2Fgif%20subtype.%20Carries%20its%20identity%20with%20the%20value%3A%20the%0A%2F%2F%20family's%20shared%20streaming%20contract%20is%20bytes%20in%20through%20the%20octetstream%0A%2F%2F%20interface%2C%20and%20the%20typed%20output%20out_image_gif_default%20(chain%20%5Bimage%2C%20gif%5D%2C%20name%0A%2F%2F%20%22default%22)%20emits%20this%20resource%20itself%20so%20the%20mime%20travels%20with%20the%20value.%0A%2F%2F%20Typed%20values%20reach%20raw-byte%20sinks%20through%20the%20family%20inputs%20(in_image_write)%2C%20not%20through%20%5Boctetstream%5D%20inputs.%0Afunction%20gif()%0A%7B%0A%09Resource.call(this%2C%22gif%22)%3B%0A%09this.Processor%20%3D%20gifProcessor%3B%0A%09return%20this%3B%0A%7D%0A%0Afunction%20gifProcessor(resource)%0A%7B%0A%09Resource.Processor.call(this%2Cresource)%3B%0A%09this.resource%20%3D%20resource%3B%0A%09resource.contentType%20%3D%20%22image%2Fgif%22%3B%0A%09this.out_image_gif_default%20%3D%20null%3B%0A%09this.in_octetstream_default_%24all%20%3D%20function(input)%0A%20%20%20%20%7B%0A%09%09resource.value%20%3D%20input.value%20instanceof%20Uint8Array%20%3F%20input.value%20%3A%20new%20Uint8Array(input.value)%3B%0A%20%20%20%20%7D%0A%09%2F%2F%20go%20fires%20the%20typed%20output%3B%20any%20octetstream%20sink%20accepts%20it%20through%20the%0A%09%2F%2F%20universal%20byte-sink%20rule%2C%20so%20no%20separate%20raw-bytes%20port%20is%20needed%0A%09this.in_go%20%3D%20function()%0A%20%20%20%20%7B%0A%09%09return%20this.out_image_gif_default%3F.(resource)%3B%0A%20%20%20%20%7D%0A%09this.in_instanciate%20%3D%20function(input)%0A%09%7B%0A%09%09let%20newObject%20%3D%20this.get_resource().clone()%3B%0A%09%09newObject.value%20%3D%20new%20Uint8Array(0)%3B%0A%09%09newObject.contentType%20%3D%20%22image%2Fgif%22%3B%0A%09%09return%20newObject.instanciate_processor()%3B%0A%09%7D%0A%09return%20this%3B%0A%7D%0Agif.Processor%3DgifProcessor%3B%0Amodule.exports%3Dgif%3B%0A]>>NewResource:image.gif
