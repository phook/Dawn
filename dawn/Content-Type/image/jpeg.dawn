[Native.Javascript:const%20Resource%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FResource%22)%3B%0A%0A%2F%2F%20Content-Type%2Fimage%2Fjpeg%20%E2%80%94%20%20Carries%20its%20identity%20with%20the%20value%3A%20the%0A%2F%2F%20family's%20shared%20streaming%20contract%20is%20bytes%20in%20through%20the%20octetstream%0A%2F%2F%20interface%2C%20bytes%20out%20on%20out_octetstream%3B%0A%2F%2F%20out_jpeg%20emits%20this%20resource%20itself%20so%20the%20mime%20travels%20with%20the%20value.%0Afunction%20jpeg()%0A%7B%0A%09Resource.call(this%2C%22jpeg%22)%3B%0A%09this.Processor%20%3D%20jpegProcessor%3B%0A%09return%20this%3B%0A%7D%0A%0Afunction%20jpegProcessor(resource)%0A%7B%0A%09Resource.Processor.call(this%2Cresource)%3B%0A%09this.resource%20%3D%20resource%3B%0A%09resource.contentType%20%3D%20%22image%2Fjpeg%22%3B%0A%09this.out_octetstream%20%3D%20null%3B%0A%09this.out_jpeg%20%3D%20null%3B%0A%09this.in_octetstream_%24all%20%3D%20function(input)%0A%20%20%20%20%7B%0A%09%09resource.value%20%3D%20input.value%20instanceof%20Uint8Array%20%3F%20input.value%20%3A%20new%20Uint8Array(input.value)%3B%0A%20%20%20%20%7D%0A%09%2F%2F%20go%20fires%20the%20most%20specific%20connected%20output%3A%20the%20self-typed%0A%09%2F%2F%20jpeg%20resource%2C%20else%20the%20raw%20bytes%0A%09this.in_go%20%3D%20function()%0A%20%20%20%20%7B%0A%09%09return%20(this.out_jpeg%20%7C%7C%20this.out_octetstream)%3F.(resource)%3B%0A%20%20%20%20%7D%0A%09this.in_instanciate%20%3D%20function(input)%0A%09%7B%0A%09%09let%20newObject%20%3D%20this.get_resource().clone()%3B%0A%09%09newObject.value%20%3D%20new%20Uint8Array(0)%3B%0A%09%09newObject.contentType%20%3D%20%22image%2Fjpeg%22%3B%0A%09%09return%20newObject.instanciate_processor()%3B%0A%09%7D%0A%09return%20this%3B%0A%7D%0Ajpeg.Processor%3DjpegProcessor%3B%0Amodule.exports%3Djpeg%3B%0A]>>NewResource:image.jpeg
