[Native.Javascript:const%20Resource%20%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FResource%22)%3B%0Aconst%20Number%20%20%20%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FNumber%22)%3B%0A%0Afunction%20modulo()%0A%7B%0A%20%20this.Number%20%3D%20new%20Number()%3B%0A%09Resource.call(this%2C%22modulo%22)%3B%0A%09this.Processor%3DmoduloProcessor%3B%0A%09return%20this%3B%0A%7D%0A%0Afunction%20moduloProcessor(resource)%0A%7B%0A%09Resource.Processor.call(this%2Cresource)%3B%20%0A%09this.resource%20%3D%20resource%3B%0A%09this.out_Number%20%3D%20null%3B%0A%09this.in_begin%20%3D%20function()%0A%09%7B%0A%09%09this.tempNumber%20%3D%20null%3B%0A%20%20%20%20%7D%0A%09this.in_Number_dividend%20%3D%20function(input)%0A%09%7B%20%2F%2F%20first%20number%20in%20the%20flow%20is%20the%20dividend%0A%09%09this.tempNumber%20%3D%20input.value%3B%0A%20%20%20%20%7D%0A%09this.in_Number_%24all%20%3D%20function(input)%0A%09%7B%20%2F%2F%20each%20following%20number%20is%20a%20divisor%2C%20applied%20in%20turn%0A%09%09this.tempNumber%20%3D%20this.tempNumber.mod(input.value)%3B%0A%20%20%20%20%7D%0A%09this.in_end%20%3D%20function()%0A%09%7B%0A%09%09if%20(this.tempNumber%20!%3D%20null)%0A%09%09%09return%20this%3F.out_Number%3F.(%7Bvalue%3Athis.tempNumber%7D)%3B%0A%20%20%20%20%7D%0A%7D%0Amodulo.Processor%3DmoduloProcessor%3B%0Amodule.exports%3Dmodulo%3B]>>NewResource:Number.modulo
