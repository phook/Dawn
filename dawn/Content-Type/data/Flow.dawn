0%20%20%20%20%20%20%20%20%20%20%20%20%20return%20result%3B%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20*%2F%0A%20%20%20%20%20%20%20%20if%20(!result)%0A%20%20%20%20%20%20%20%20%20%20%20%20if%20(searchToRoot%20%26%26%20resource.owner)%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20result%20%3D%20await%20resource.owner.default_processor().lookup(identifier%2C%20searchToRoot)%3B%0A%0A%20%20%20%20%20%20%20%20if%20(!result)%0A%20%20%20%20%20%20%20%20%20%20%20%20result%20%3D%20this.previousLookup(identifier%2CsearchToRoot)%3B%0A%0A%20%20%20%20%20%20%20%20if%20(!result)%0A%20%20%20%20%20%20%20%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%2F%2F%20indicate%20error%20%3F%20output_error%20is%20not%20bound%0A%20%20%20%20%20%20%20%20%7D%20%0A%0A%20%20%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20return%20result%3B%0A%20%20%20%20%7D%0A%09this.get_output_types%20%3D%20function()%20%7B%0A%20%20%20%20%20%20%20%20let%20previousElement%20%3D%20resource.elements.at(-1)%3B%0A%20%20%20%20%20%20%20%20if%20(previousElement)%0A%09%09%09return%20previousElement.get_output_types()%3B%0A%09%09return%20new%20Set()%3B%0A%09%7D%0A%09%0A%20%20%20%20this.in_instanciate%20%3D%20function(input)%20%7B%0A%20%20%20%20%20%20%20%20let%20newObject%20%3D%20Object.assign(%7B%7D%2C%20this)%3B%20%2F%2F%20Clone%0A%20%20%20%20%20%20%20%20newObject.elements%20%3D%20%5B%5D%3B%20%2F%2F%20Instanciate%20and%20empty%20list%0A%20%20%20%20%20%20%20%20return%20newObject.instanciate_processor()%3B%0A%20%20%20%20%7D%0A%0A%20%20%20%20this.in_go%20%3D%20function()%20%7B%0A%20%20%20%20%20%20%20%20if%20(resource.elements.length%20%3E%200)%20%7B%0A%20%20%20%20%20%20%20%20%20%20%20%20this.program%20%3D%20%5B%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20resource.elements.at(0).in_begin%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20resource.elements.at(0).in_go%2C%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20resource.elements.at(0).in_end%0A%20%20%20%20%20%20%20%20%20%20%20%20%5D%3B%0A%20%20%20%20%