[Native.Javascript:const%20Resource%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FResource%22)%3B%0A%0A%2F%2F%20THIS%20IS%20THE%20DATA%20HOLDER%20-%20MAPPING%20TO%20NATIVE%20TYPE%20-%20IN%20THIS%20CASE%20A%20JAVASCRIPT%20DATASTREAM%0Afunction%20Data()%0A%7B%0A%20%20%20%20Resource.call(this%2C%22Data%22)%3B%20%2F%2F%20REMOVE%20NAMING%20-%20BUT%20LEAVE%20FOR%20DEBUG%20FOR%20NOW%0A%20%20%20%20this.Processor%20%3D%20DataProcessor%3B%0A%7D%0A%0A%2F%2F%20THIS%20IS%20THE%20PROCESSOR%20ASSOCIATED%20WITH%20DATA%20-%20EVERY%20FLOW%20ACCESSING%20DATA%20MUST%20INSTANCIATE%20ON%20OF%20THESE%20TO%20OPERATE%20ON%20THE%20VALUE%0A%2F%2F%20SINCE%20DATA%20IS%20AN%20OBJECT%2C%20MULTIPLE%20PROCESSORS%20FOR%20THE%20DATA%20CAN%20BE%20CREATED%2C%20EACH%20POINTING%20TO%20THE%20ORIGINAL%20PIECE%20OF%20DATA%0Afunction%20DataProcessor(resource)%0A%7B%0A%20%20Resource.Processor.call(this%2Cresource)%3B%20%0A%09this.resource%20%3D%20resource%3B%0A%09this.out_Data_default%20%3D%20null%3B%0A%09this.out_octetstream_default%20%3D%20null%3B%0A%09this.in_octetstream_default_%24all%20%3D%20function(input)%0A%20%20%20%20%7B%0A%20%20%20%20%20%20let%20text%20%3D%20new%20TextDecoder().decode((input.value%20instanceof%20Uint8Array%20%3F%20input.value%20%3A%20new%20Uint8Array(input.value)))%3B%0A%20%20%20%20%20%20try%20%7B%20resource.value%20%3D%20JSON.parse(text)%3B%20%7D%0A%20%20%20%20%20%20catch(e)%20%7B%20resource.value%20%3D%20text%3B%20%7D%0A%20%20%20%20%7D%0A%09this.toBlob%20%3D%20function()%0A%20%20%20%20%7B%0A%20%20%20%20%20%20return%20new%20TextEncoder().encode(JSON.stringify(resource.value))%3B%0A%20%20%20%20%7D%0A%09this.in_Data_default%20%3D%20function(input)%0A%20%20%20%20%7B%20%20%20%0A%20%20%20%20%20%20resource.value%20%3D%20input.value%3B%0A%20%20%20%20%7D%0A%20%20%20%20this.in_go%20%3D%20function()%0A%20%20%20%20%7B%0A%20%20%20%20%20%20%20%20return%20this%3F.out_Data_default(resource)%3B%0A%20%20%20%20%7D%0A%20%20%20%20this.in_instanciate%20%3D%20function(input)%0A%20%20%20%20%7B%20%20%20%0A%09%09%20let%20newObject%3Dthis.get_resource().clone()%3B%20%2F%2F%20Clone%0A%20%20%20%20%20return%20newObject.instanciate_processor()%3B%0A%20%20%20%20%7D%0A%09return%20this%3B%0A%7D%0AData.Processor%3DDataProcessor%3B%0Amodule.exports%3DData%3B]>>NewResource:Data
