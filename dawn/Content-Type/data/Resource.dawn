his.clone%20%3D%20function()%20%7B%0A%20%20%20%20%20%20%20%20return%20clone(this)%3B%0A%20%20%20%20%7D%0A%0A%20%20%20%20return%20this%3B%0A%7D%0A%0A%0A%2F*%0A%0A%20%20Build%20list%20of%20input%20functions%0A%20%20Build%20list%20of%20outut%20functions%0A%0A%20%20at%20lookup%3A%0A%20%20build%20list%20of%20possible%20inputs%0A%20%20build%20list%20of%20possible%20outputs%0A%20%20build%20list%20of%20possible%20outputs%20types%20(build%20from%20the%20possible%20outputs%20list)%0A%20%20%0A%20%20lookup%20builds%20list%20of%20all%20inputs%2C%20if%20inputs%20are%20not%20excplicitly%20listed%3A%20foo.bar%2Fbleh%3Finput%26input%26input%0A%20%20explicitely%20specified%20inputs%20gets%20group%20removed%0A%20%20foo.bar%2Fbleh%3Finput%3D1%20only%20removes%20input%20from%20posible%20list%0A%20%20possible%20list%20can%20replace%20connection%20array%20(catchall(%24)%20are%20not%20removed)%0A%20%20%0A%20%20lookup%20builds%20list%20of%20all%20outputs%2C%20if%20outputs%20are%20not%20excplicitly%20listed%3A%20foo.bar%2Fbleh%23output%26output%26output%0A%20%20explicitely%20specified%20outputs%20gets%20group%20removed%0A%20%20lookup%20can%20be%20overidden%20for%20excel%2C%20csv%20files%20to%20support%20http%3A%2F%2Fexample.com%2Fdata.csv%23row%3D5-7%20format%20(would%20be%20redirected%20to%20inputs%20in%20dawn)%0A%20%20%0A%20%20%0A%20%20at%20connect%3A%0A%20%20offer%20possible%20outputs%20to%20device%20connecting%20to%0A%20%20accept%20outputs%20that%20matches%20the%20possible%20inputs%0A%20%20%0A%20%20groups%20outputs%20should%20be%20offered%20in%20orders%0A%20%20include%20rules%20for%20groups%20-%20concept%20-%20first%20input%20connecting%20fixes%20the%20group%20number%20so%20now%20fewer%20are%20available%0A%20%20same%20rule%20for%20outputs%20first%20output%20connecting%20fixes%20the%20group%20number%20so%20fewer%20are%20available%0A%20%20%0A%20%20group%200%20(or%20no%20group)%20are%20always%20possible%20-%20begin%2C%20end%2C%20error%2C%20go%3F%0A%20%20explicits%20are%20only%20available%20when%20mentioned%20in%20the%20in%20or%20output%20lists%20(lookup%3F)%0A%0A%20%20_%24all%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20-%20does%20not%20disappear%20from%20input%20list%20when%20connected%0A%20%20_%24explicit%20%20%20%20%20%20%20%20%20%20-%20does%20only%20appear%20in%20list%20if%20explicitly%20mentioned%0A%20%20_%24group_name%20%20%20%20%20%20%20%20-%20groups%20inputs%2C%20so%20if%20one%20is%20connected%20all%20other%20groups%20are%20removed%0A%0A%20%20%3E%3ENewInput%3ABoolean%3Aminuend%26tag%3Dall%0A%20%20%3E%3ENewInput%3ABoolean%3Aminuend%26group%3Dname%0A*%2F%0Aconst%20isInput%20%20%20%20%3D%20%22in_%22%3B%0Aconst%20isOutput%20%20%20%3D%20%22out_%22%3B%0Aconst%20isExplicit%20%3D%20%22_%24explicit%22%3B%0Aconst%20isCatchAll%20%3D%20%22_%24all%22%3B%0Aconst%20isGroup%20%20%20%20%3D%20%22_%24group_%22%3B%0A%0Aconst%20protectedFunctions%20%3D%20%5B%22in_go%22%2C%22in_begin%22%2C%22in_end%22%2C%22in_error%22%2C%22out_begin%22%2C%22out_end%22%2C%22out_error%22%5D%3B%0A%0Afunction%20ResourceProcessor(resource)%20%7B%0A%20%20%20%20this.get_resource%20%3D%20function()%20%7B%0A%20%20%20%20%20%20%20%20return%20resource%3B%0A%20%20%20%20%7D%0A%0A%20%20%20%20this.mythen%20%3D%20function(possiblePromise%2C%20fn)%20%7B%0A%20%20%20%20%20%20%20%20if%20(possiblePromise)%0A%20%20%20%20%20%20%20%20%20%20%20%20return%20possiblePromise.then(fn)%3B%0A%20%20%20%20%20%20%20%20else%0A%20%20%20%20%20%20%20%20%20%20%20%20return%20fn()%3B%0A%20%20%20%20%7D%0A%0A%0A%20%20%20%20this.inputList%20%3D%20%7B%7D%3B%0A%20%20%20%20this.outputList%20%3D%20%7B%7D%3B%0A%20%20%20%20this.output_types%20%3D%20null%3B%0A%20%20%20%20this.endParameters%20%3D%20%7B%7D%3B%0A%20%0A%20%20%20%20this.lookup%20%3D%20async%20function(identifier)%20%7B%0A%20%20%20%20%20%20%20%20return%20await%20this.lookup_new(%22*.%22%2Bidentifier%2Ctrue)%3B%0A%20%20%20%20%20%20%7D%0A%20%20%20%20this.lookup_new%20%3D%20async%20function(identifier%2C%20searchToRoot)%20%7B%0A%20%20%20%20%20%20%20%20if%20(typeof(searchToRoot