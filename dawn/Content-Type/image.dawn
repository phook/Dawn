[Native.Javascript:const%20Resource%20%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FResource%22)%3B%0A%0A%2F%2F%20Content-Type%2Fimage%20%E2%80%94%20family%20main%20for%20image%2F*%3A%20the%20raw%20bytes%20as%20a%20Blob%2C%0A%2F%2F%20until%20a%20typed%20Image%20resource%20lands%20at%20Content-Type%2Fimage%20(subtypes%20like%0A%2F%2F%20Content-Type%2Fimage%2Fpng%20can%20override%20by%20dropping%20a%20file%20in%20that%20folder).%0Afunction%20image()%0A%7B%0A%09Resource.call(this%2C%22image%22)%3B%0A%09this.Processor%20%3D%20imageProcessor%3B%0A%09return%20this%3B%0A%7D%0A%0Afunction%20imageProcessor(resource)%0A%7B%0A%09Resource.Processor.call(this%2Cresource)%3B%0A%09this.resource%20%3D%20resource%3B%0A%09this.out_octetstream%20%3D%20null%3B%0A%09this.in_octetstream_%24all%20%3D%20function(input)%0A%20%20%20%20%7B%0A%09%09resource.value%20%3D%20input.value%20instanceof%20Uint8Array%20%3F%20input.value%20%3A%20new%20Uint8Array(input.value)%3B%0A%20%20%20%20%7D%0A%09this.in_go%20%3D%20function()%0A%20%20%20%20%7B%0A%09%09return%20this.out_octetstream%3F.(resource)%3B%0A%20%20%20%20%7D%0A%09this.in_instanciate%20%3D%20function(input)%0A%20%20%20%20%7B%0A%09%09let%20newObject%20%3D%20this.get_resource().clone()%3B%0A%09%09newObject.value%20%3D%20new%20Uint8Array(0)%3B%0A%09%09return%20newObject.instanciate_processor()%3B%0A%20%20%20%20%7D%0A%09return%20this%3B%0A%7D%0Aimage.Processor%3DimageProcessor%3B%0Amodule.exports%3Dimage%3B]>>NewResource:image
