[Native.Javascript:const%20Resource%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FResource%22)%3B%0A%0A%2F%2F%20exit%3AN%20%E2%80%94%20on%20go%20(or%20on%20a%20Number%20input)%20terminates%20the%20process%20with%20code%20N.%0A%2F%2F%20exit%3A%20alone%20exits%20with%200.%0Afunction%20exit()%0A%7B%0A%09Resource.call(this%2C%22exit%22)%3B%0A%09this.Processor%20%3D%20exitProcessor%3B%0A%09return%20this%3B%0A%7D%0A%0Afunction%20exitProcessor(resource)%0A%7B%0A%09Resource.Processor.call(this%2Cresource)%3B%0A%09this.resource%20%3D%20resource%3B%0A%09let%20code%20%3D%200%3B%0A%09let%20armed%20%3D%20typeof%20process%20!%3D%3D%20%22undefined%22%3B%0A%0A%09this.in_instanciate%20%3D%20function(input)%0A%09%7B%0A%09%09let%20newObject%20%3D%20this.get_resource().clone()%3B%0A%09%09let%20n%20%3D%20parseInt(decodeURIComponent(input.value%20%7C%7C%20%22%22))%3B%0A%09%09newObject.code%20%3D%20isNaN(n)%20%3F%200%20%3A%20n%3B%0A%09%09return%20newObject.instanciate_processor()%3B%0A%09%7D%3B%0A%09code%20%3D%20resource.code%20%7C%7C%200%3B%0A%0A%09this.in_Number_%24all%20%3D%20function(input)%20%7B%20code%20%3D%20input.value%3B%20%7D%3B%0A%09%0A%0A%09this.in_go%20%3D%20function()%0A%09%7B%0A%09%09if%20(armed)%20process.exit(code)%3B%0A%09%7D%3B%0A%09return%20this%3B%0A%7D%0Aexit.Processor%20%3D%20exitProcessor%3B%0Amodule.exports%20%3D%20exit%3B]>>NewResource:exit
