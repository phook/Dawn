Meta.documentation:httpConnection.path
Meta.documentation:
Meta.documentation:The request path as a String: the accepted connection's URL with
Meta.documentation:the query string stripped. The thin adapter that hands an HTTP path
Meta.documentation:to a filesystem resource (file: parses its own file:/// form).
Meta.documentation:
Meta.documentation:@port in_httpConnection_$all - an accepted httpConnection (meta on .value)
Meta.documentation:@port out_String_default - the request path
Meta.documentation:@see httpConnection
Meta.documentation:@see file
Meta.documentation:@kind operator
Meta.documentation:@status experimental
[Native.Javascript:const%20Resource%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FResource%22)%3B%0A%0A%2F%2F%20httpConnection.path%20%E2%80%94%20the%20request-path%20adapter%20for%20the%20file-reading%0A%2F%2F%20routes.%20Two%20modes%2C%20chosen%20by%20the%20URI%20tail%3A%0A%2F%2F%0A%2F%2F%20BARE%20%20httpConnection.path%3A%20%E2%80%94%20the%20%2Ffile%3A%2F%2F%2F%20read-route%20adapter%3A%20only%0A%2F%2F%20%20%20%2Ffile%3A%2F%2F%2F%20paths%20flow%20on%20(the%20raw%20path%2C%20undecoded%20%E2%80%94%20the%20reference%20file%0A%2F%2F%20%20%20route%20serves%20them%20as-is)%3B%20everything%20else%20stays%20silent.%0A%2F%2F%0A%2F%2F%20BASE%20%20httpConnection.path%3A%3Cbase%3E%20%E2%80%94%20the%20static-mount%20adapter%3A%20serves%20the%0A%2F%2F%20%20%20files%20under%20%3Cbase%3E%20(e.g.%20httpConnection.path%3Apublic).%20Skips%20%2Ffile%3A%2F%2F%2F%0A%2F%2F%20%20%20paths%20(the%20%2Ffile%3A%2F%2F%2F%20adapter%20owns%20those).%20Rejects%20%22..%22%20traversal%20with%0A%2F%2F%20%20%20403%20Forbidden%20(express.static%20parity).%20%22%2F%22%20serves%20%3Cbase%3E%2Findex.html.%0A%2F%2F%20%20%20A%20path%20whose%20file%20does%20not%20exist%20stays%20SILENT%20%E2%80%94%20the%20request%20falls%0A%2F%2F%20%20%20through%20to%20the%20catch-all%20204%20(express.static's%20next()%20parity).%0A%2F%2F%20The%20emitted%20path%20feeds%20file%3A's%20in_String_read%3B%20the%20content-type%20comes%0A%2F%2F%20from%20the%20file%20resource's%20reference%20mime%20handling.%0Afunction%20path()%0A%7B%0A%09Resource.call(this%2C%22path%22)%3B%0A%09this.Processor%20%3D%20pathProcessor%3B%0A%09return%20this%3B%0A%7D%0A%0Afunction%20pathProcessor(resource)%0A%7B%0A%09Resource.Processor.call(this%2Cresource)%3B%0A%09this.resource%20%3D%20resource%3B%0A%09this.out_String_default%20%3D%20null%3B%0A%0A%09this.in_instanciate%20%3D%20function(input)%0A%09%7B%0A%09%09let%20newObject%20%3D%20this.get_resource().clone()%3B%0A%09%09newObject.base%20%3D%20(input%20%26%26%20input.value)%20%3F%20decodeURIComponent(input.value)%20%3A%20%22%22%3B%0A%09%09return%20newObject.instanciate_processor()%3B%0A%09%7D%3B%0A%0A%09this.in_httpConnection_%24all%20%3D%20function(input)%0A%09%7B%0A%09%09const%20conRes%20%3D%20(input%20%26%26%20input.get_resource)%20%3F%20input.get_resource()%20%3A%20input%3B%0A%09%09const%20meta%20%3D%20conRes%20%26%26%20conRes.value%3B%0A%09%09if%20(!meta%20%7C%7C%20typeof%20meta.url%20%3D%3D%3D%20%22undefined%22)%20return%3B%0A%09%09const%20url%20%3D%20String(meta.url).split(%22%3F%22)%5B0%5D%3B%0A%09%09if%20(!Dawn.isServer())%20return%3B%0A%09%09const%20emit%20%3D%20(value)%20%3D%3E%0A%09%09%7B%0A%09%09%09const%20s%20%3D%20new%20(Dawn.require(%22Content-Type%2Fdata%2FString%22))()%3B%0A%09%09%09s.value%20%3D%20value%3B%0A%09%09%09return%20this.out_String_default%3F.(s.instanciate_processor())%3B%0A%09%09%7D%3B%0A%09%09if%20(resource.base)%0A%09%09%7B%0A%09%09%09%2F%2F%20static-mount%20mode%3A%20serve%20%3Cbase%3E%20to%20local%20GETs%0A%09%09%09if%20(url.indexOf(%22%2Ffile%3A%2F%2F%2F%22)%20%3D%3D%3D%200)%20return%3B%20%2F%2F%20the%20%2Ffile%3A%2F%2F%2F%20adapter%20owns%20these%0A%09%09%09const%20segments%20%3D%20url.split(%22%2F%22)%3B%0A%09%09%09if%20(segments.indexOf(%22..%22)%20!%3D%3D%20-1)%0A%09%09%09%7B%0A%09%09%09%09return%20this.out_error%3F.(%7B%20value%3A%20%22Forbidden%22%2C%20status%3A%20403%20%7D)%3B%0A%09%09%09%7D%0A%09%09%09let%20rel%20%3D%20url%20%3D%3D%3D%20%22%2F%22%20%7C%7C%20url%20%3D%3D%3D%20%22%22%20%3F%20%22%2Findex.html%22%20%3A%20url%3B%0A%09%09%09%2F%2F%20mount-prefix%20parity%3A%20%2F%3Cbase%3E%2F...%20serves%20%3Cbase%3E%2F...%20(express.static%20mount%0A%09%09%09%2F%2F%20semantics)%20-%20lets%20a%20browser%20fetch%20%2Fdawn%2F...%20while%20this%20mount%20serves%20dawn%2F...%0A%09%09%09const%20segs%20%3D%20rel.split(%22%2F%22).filter(s%20%3D%3E%20s%20!%3D%3D%20%22%22)%3B%0A%09%09%09if%20(segs%5B0%5D%20%3D%3D%3D%20resource.base)%20rel%20%3D%20rel.substring(resource.base.length%20%2B%201)%20%7C%7C%20%22%2F%22%3B%0A%09%09%09const%20_fs%20%3D%20require(%22fs%22)%3B%0A%09%09%09const%20abs%20%3D%20require(%22path%22).resolve(resource.base%20%2B%20rel)%3B%0A%09%09%09if%20(!_fs.existsSync(abs))%20return%3B%20%2F%2F%20fall%20through%20to%20the%20catch-all%20204%0A%09%09%09emit(resource.base%20%2B%20rel)%3B%0A%09%09%09return%3B%0A%09%09%7D%0A%09%09%2F%2F%20bare%20mode%3A%20the%20%2Ffile%3A%2F%2F%2F%20read-route%20adapter%0A%09%09if%20(url.indexOf(%22%2Ffile%3A%2F%2F%2F%22)%20!%3D%3D%200)%20return%3B%0A%09%09emit(url)%3B%0A%09%7D%3B%0A%09return%20this%3B%0A%7D%0Apath.Processor%20%3D%20pathProcessor%3B%0Amodule.exports%20%3D%20path%3B%0A]>>NewResource:httpConnection.path
