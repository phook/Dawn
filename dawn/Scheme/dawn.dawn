Meta.documentation:@port out_String - one event per inner-program print
Meta.documentation:@port in_String_$all - canonical Dawn source to compile and run
Meta.documentation:@port in_octetstream_$all - source as raw bytes
Meta.documentation:@kind operator
Meta.documentation:@status experimental

[Native.Javascript:const%20Resource%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FResource%22)%3B%0Aconst%20StringRes%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FString%22)%3B%0Aconst%20AsyncFn%20%3D%20Object.getPrototypeOf(async%20function()%7B%7D).constructor%3B%0A%0A%2F%2F%20dawn%3A%20%E2%80%94%20the%20meta%20resource.%20Receives%20canonical%20Dawn%20source%20(String%20or%20the%0A%2F%2F%20octetstream%20interface)%2C%20compiles%20it%20with%20the%20DawnCompiler%20and%20runs%20it%20on%20a%0A%2F%2F%20fresh%20processor.%20Prints%20of%20the%20inner%20program%20are%20forwarded%20as%20out_String%0A%2F%2F%20events%3B%20failures%20go%20to%20out_error.%0A%2F%2F%0A%2F%2F%20Flows%20propagate%20through%20ports%3A%20only%20the%20chain%20head's%20in_go%20fires%2C%20so%20the%0A%2F%2F%20run%20must%20start%20when%20source%20ARRIVES%20on%20in_String%20%2F%20in_octetstream.%0Afunction%20dawn()%0A%7B%0A%09Resource.call(this%2C%22dawn%22)%3B%0A%09this.Processor%20%3D%20dawnProcessor%3B%0A%09return%20this%3B%0A%7D%0A%0Afunction%20dawnProcessor(resource)%0A%7B%0A%09Resource.Processor.call(this%2Cresource)%3B%0A%09this.resource%20%3D%20resource%3B%0A%09this.out_String%20%3D%20null%3B%0A%09let%20source%20%3D%20%22%22%3B%0A%09let%20ran%20%3D%20false%3B%0A%0A%09this.in_instanciate%20%3D%20function(input)%0A%09%7B%0A%09%09let%20newObject%20%3D%20this.get_resource().clone()%3B%0A%09%09newObject.source%20%3D%20decodeURIComponent(input.value%20%7C%7C%20%22%22)%3B%0A%09%09return%20newObject.instanciate_processor()%3B%0A%09%7D%3B%0A%09if%20(resource.source)%20source%20%3D%20resource.source%3B%0A%0A%09this.in_String_%24all%20%3D%20function(input)%20%7B%20source%20%3D%20input.value%3B%20this.run()%3B%20%7D%3B%0A%09this.in_octetstream_%24all%20%3D%20function(input)%0A%09%7B%0A%09%09source%20%3D%20new%20TextDecoder().decode(input.value%20instanceof%20Uint8Array%20%3F%20input.value%20%3A%20new%20Uint8Array(input.value))%3B%0A%09%09this.run()%3B%0A%09%7D%3B%0A%0A%09this.in_go%20%3D%20function()%20%7B%20this.run()%3B%20%7D%3B%20%2F%2F%20URI-supplied%20source%3A%20nothing%20arrives%20through%20a%20port%0A%0A%09this.run%20%3D%20function()%0A%09%7B%0A%09%09if%20(ran%20%7C%7C%20!source)%20return%3B%0A%09%09ran%20%3D%20true%3B%0A%09%09const%20self%20%3D%20this%3B%0A%09%09const%20compiled%20%3D%20new%20(Dawn.require(%22DawnCompiler%22))().parse(source)%3B%0A%09%09if%20(typeof%20compiled%20!%3D%3D%20%22string%22%20%7C%7C%20compiled.indexOf(%22ERROR%22)%20%3D%3D%3D%200)%0A%09%09%7B%0A%09%09%09this.out_error%3F.(%7B%20value%3A%20%22dawn%3A%20source%20failed%20to%20compile%22%20%7D)%3B%0A%09%09%09return%3B%0A%09%09%7D%0A%09%09const%20prevPrint%20%3D%20Dawn.print%3B%20%2F%2F%20swap%20the%20print%20channel%20for%20the%20inner%20run%0A%09%09Dawn.print%20%3D%20function(text)%0A%09%09%7B%0A%09%09%09let%20s%20%3D%20new%20StringRes()%3B%0A%09%09%09s.value%20%3D%20String(text)%3B%0A%09%09%09self.out_String%3F.(s)%3B%0A%09%09%7D%3B%0A%09%09(async%20function()%20%7B%0A%09%09%09try%0A%09%09%09%7B%0A%09%09%09%09const%20processor%20%3D%20Dawn.instanciate_processor()%3B%0A%09%09%09%09const%20list%20%3D%20await%20(new%20AsyncFn(%22return%20%22%20%2B%20compiled)).call(processor)%3B%0A%09%09%09%09if%20(list)%20await%20list.in_go()%3B%0A%09%09%09%7D%0A%09%09%09catch%20(err)%0A%09%09%09%7B%0A%09%09%09%09self.out_error%3F.(%7B%20value%3A%20String(err%20%26%26%20err.message%20%7C%7C%20err)%20%7D)%3B%0A%09%09%09%7D%0A%09%09%09finally%0A%09%09%09%7B%0A%09%09%09%09Dawn.print%20%3D%20prevPrint%3B%0A%09%09%09%7D%0A%09%09%7D)()%3B%0A%09%7D%3B%0A%09return%20this%3B%0A%7D%0Adawn.Processor%20%3D%20dawnProcessor%3B%0Amodule.exports%20%3D%20dawn%3B]>>NewResource:dawn
