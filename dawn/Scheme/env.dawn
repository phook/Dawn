[Native.Javascript:const%20Resource%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FResource%22)%3B%0A%0A%2F%2F%20env%3ANAME%20%E2%80%94%20reads%20a%20process%20environment%20variable%2C%20hands%20it%20downstream%20as%20String%0Afunction%20env()%0A%7B%0A%09Resource.call(this%2C%22env%22)%3B%0A%09this.Processor%3DenvProcessor%3B%0A%09return%20this%3B%0A%7D%0Afunction%20envProcessor(resource)%0A%7B%0A%09Resource.Processor.call(this%2Cresource)%3B%0A%09this.resource%3Dresource%3B%0A%09this.out_String_default%3Dnull%3B%0A%09this.in_instanciate%3Dfunction(input)%0A%09%7B%0A%09%09let%20n%3Dthis.get_resource().clone()%3B%0A%09%09n.value%3DdecodeURIComponent(input.value)%3B%0A%09%09return%20n.instanciate_processor()%3B%0A%09%7D%3B%0A%09this.in_go%3Dfunction()%0A%09%7B%0A%09%09let%20v%3D(typeof%20process!%3D%3D%22undefined%22%26%26process.env)%3Fprocess.env%5Bresource.value%5D%3Aundefined%3B%0A%09%09const%20StringRes%3DDawn.require(%22Content-Type%2Fdata%2FString%22)%3B%0A%09%09let%20s%3Dnew%20StringRes()%3B%0A%09%09s.value%3D(v%3D%3D%3Dundefined%7C%7Cv%3D%3D%3Dnull)%3F%22%22%3AString(v)%3B%0A%09%09return%20this.out_String_default%3F.(s)%3B%0A%09%7D%3B%0A%09return%20this%3B%0A%7D%0Aenv.Processor%3DenvProcessor%3B%0Amodule.exports%3Denv%3B]>>NewResource:env