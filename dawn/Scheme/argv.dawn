[Native.Javascript:const%20Resource%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FResource%22)%3B%0Aconst%20StringRes%20%3D%20Dawn.require(%22Content-Type%2Fdata%2FString%22)%3B%0A%0A%2F%2F%20argv%3AN%20%E2%80%94%20Nth%20command-line%20argument%20(process.argv%5B2%2BN%5D%20under%20%60node%0A%2F%2F%20dawn_run.js%60)%3B%20handed%20downstream%20as%20String%20on%20go.%20Empty%20when%20absent.%0Afunction%20argv()%0A%7B%0A%09Resource.call(this%2C%22argv%22)%3B%0A%09this.Processor%20%3D%20argvProcessor%3B%0A%09return%20this%3B%0A%7D%0A%0Afunction%20argvProcessor(resource)%0A%7B%0A%09Resource.Processor.call(this%2Cresource)%3B%0A%09this.resource%20%3D%20resource%3B%0A%09this.out_String%20%3D%20null%3B%0A%09this.in_instanciate%20%3D%20function(input)%0A%09%7B%0A%09%09let%20newObject%20%3D%20this.get_resource().clone()%3B%0A%09%09newObject.index%20%3D%20parseInt(decodeURIComponent(input.value%20%7C%7C%20%22%22))%20%7C%7C%200%3B%0A%09%09return%20newObject.instanciate_processor()%3B%0A%09%7D%3B%0A%09this.in_go%20%3D%20function()%0A%09%7B%0A%09%09const%20argv%20%3D%20(typeof%20process%20!%3D%3D%20%22undefined%22%20%26%26%20process.argv)%20%3F%20process.argv.slice(3)%20%3A%20%5B%5D%3B%0A%09%09let%20s%20%3D%20new%20StringRes()%3B%0A%09%09s.value%20%3D%20argv%5Bresource.index%5D%20%3D%3D%3D%20undefined%20%3F%20%22%22%20%3A%20String(argv%5Bresource.index%5D)%3B%0A%09%09this.out_String%3F.(s)%3B%0A%09%7D%3B%0A%09return%20this%3B%0A%7D%0Aargv.Processor%20%3D%20argvProcessor%3B%0Amodule.exports%20%3D%20argv%3B]>>NewResource:argv
